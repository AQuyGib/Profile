Options -Indexes

<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|package(-lock)?\.json|server\.ts|Dockerfile|docker-compose\.yml)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(README|LICENSE)\.md$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/database\.sql$ - [F,L]
  RewriteRule ^(node_modules|vendor|\.git|\.github|\.serena|\.agents)/ - [F,L]
</IfModule>
